rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /login_events/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['email', 'fullname', 'source', 'loggedAt', 'userAgent'])
        && request.resource.data.email is string
        && request.resource.data.fullname is string
        && request.resource.data.source is string
        && request.resource.data.loggedAt is timestamp
        && request.resource.data.userAgent is string;
      allow update, delete: if false;
    }
  }
}
